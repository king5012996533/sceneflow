generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/ic-prisma"
}

datasource db {
  provider = "postgresql"
  // URL 定义在 prisma.config.ts 中
}

// 使用 ic_ 前缀避免与 Creatify 主站表名冲突
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String    @default("")
  password      String?                       // OAuth 用户可以没有密码
  phone         String?                       // 手机号（可选）
  emailVerified DateTime?                     // 邮箱验证时间
  phoneVerified DateTime?                     // 手机验证时间
  avatarUrl     String?
  githubId      String?    @unique            // GitHub OAuth ID
  role          String    @default("user")    // user | pro | admin
  bannedAt      DateTime?
  banReason     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  usageRecords  UsageRecord[]
  generationJobs GenerationJob[]
  auditLogs     AdminAuditLog[] @relation("AdminAuditActor")
  config        UserConfig?
  creditBalance CreditBalance?
  creditTransactions CreditTransaction[]
}

// 用户配置（API Key、模型设置等，跨设备同步）
model UserConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    String   // projects | storage_bytes | concurrent_jobs | hd_exports | private_characters | team_members
  used      Int      @default(0)
  limit     Int?
  period    String   @default("lifetime") // lifetime | monthly
  resetAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, period])
  @@index([metric])
}

model GenerationJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey     String   @unique
  kind           String   // image | video | audio | text | tool
  count          Int      @default(1)
  status         String   @default("running") // running | succeeded | failed | cancelled
  error          String?
  metadata       Json?
  resultUrl      String?                       // 生成结果 URL（图片/视频）
  quotaRefunded  Boolean  @default(false)
  creditsCost    Int      @default(0)          // 本次消耗积分（失败退款依据）
  costCents      Int?                          // 平台估算成本（分，供对账与定价校准）
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

// 积分包（充值商品；平台统一 Key + 积分制）
model CreditPackage {
  id           String   @id @default(cuid())
  name         String
  credits      Int
  priceCents   Int
  currency     String   @default("CNY")
  bonusCredits Int      @default(0) // 赠送积分
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  orders       Order[]

  @@index([isActive, sortOrder])
}

// 积分余额（一用户一行；平台统一 Key + 积分制）
model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // 单位：积分（整数）
  updatedAt DateTime @updatedAt
}

// 积分流水（审计必需：充值/赠送/消费/退款/调整/过期）
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // purchase | grant | consume | refund | adjust | expire
  amount       Int      // 正负：充值/赠送为正，消费为负
  balanceAfter Int
  refType      String?  // generation_job | order | manual | daily_grant
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refType, refId])
}

model Order {
  id              String         @id @default(cuid())
  orderNo         String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId       String?        // 积分包订单
  package         CreditPackage? @relation(fields: [packageId], references: [id])
  amount          Int
  currency        String         @default("CNY")
  status          String         @default("pending") // pending | paid | cancelled | failed | refunded
  provider        String         @default("wechat") // wechat | alipay | stripe | manual
  billingCycle    String         @default("manual")
  providerOrderNo String?
  paidAt          DateTime?
  metadata        Json?
  paymentEvents   PaymentEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([provider])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  eventType       String
  providerEventId String?
  payload         Json?
  createdAt       DateTime @default(now())

  @@index([provider, eventType])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([target, targetId])
}

model ModelConfig {
  id          String   @id @default(cuid())
  provider    String
  model       String
  displayName String
  type        String   @default("image") // image | video | audio | text
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  params      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, model, type])
  @@index([type, enabled])
}

// 平台统一管理的上游 API 密钥
// keyEnc 为 AES-256-GCM 加密后的密文，密钥在服务端 env（PLATFORM_KEY_ENCRYPTION_SECRET），永不进客户端
model ProviderCredential {
  id          String   @id @default(cuid())
  name        String                         // 展示名，如 "MiniMax 生产 Key"
  provider    String                         // minimax | seedance | openai | replicate | gemini | deepseek ...
  baseUrl     String                         // 渠道基址（不含 /v1 之类后缀，匹配时归一化）
  keyEnc      String                         // AES-256-GCM：base64(iv:tag:cipher)
  models      String[]  @default([])         // 绑定的模型；空数组 = 该 provider 全部模型
  capabilities Json?                        // 逐模型能力标定（与前端设置面板一一对应），key=模型名
  enabled     Boolean  @default(true)
  priority    Int      @default(0)           // 同 provider 多 Key 时的优先级（越大越优先）
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider, enabled])
}

model OperationConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json?
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationCode {
  id        String   @id @default(cuid())
  target    String                          // 邮箱或手机号
  method    String                          // "email" | "phone"
  code      String                          // 6位验证码
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([target, method])
  @@index([expiresAt])
}

model CanvasBackup {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "projects" | "assets" | "image-workbench" | "video-workbench"
  data      Json?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique                // "auth:ip:{ip}" | "auth:target:{target}"
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
