{
    "name": "sceneflow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
        "director:dev": "npm --prefix ../apps/agentic-3d-director run dev -- --host 127.0.0.1",
        "director:agent": "npm --prefix ../apps/agentic-3d-director run agent",
        "director:build": "npm --prefix ../apps/agentic-3d-director run build",
        "director:sync-static": "node scripts/sync-director-desk.mjs",
        "director:test:agent": "npm --prefix ../apps/agentic-3d-director run test:agent",
        "build:with-director": "npm run director:build && npm run director:sync-static && next build",
        "build": "next build",
        "build:webpack": "next build --webpack",
        "typecheck": "tsc --noEmit",
        "guard": "node scripts/regression-guards.mjs",
        "test:memory": "node scripts/memory-unit-tests.mjs",
        "test:asset": "node scripts/asset-tier-unit-tests.mjs",
        "test:media": "node scripts/media-store-unit-tests.mjs",
        "test:scheduler": "node scripts/run-state-unit-tests.mjs && node scripts/run-control-unit-tests.mjs",
        "test:error": "node scripts/canvas-error-unit-tests.mjs",
        "test:proxy": "node scripts/outbound-proxy-unit-tests.mjs",
        "test:proxyclient": "node scripts/proxy-client-unit-tests.mjs",
        "test:imagetask": "node scripts/image-task-unit-tests.mjs",
        "test:ratio": "node scripts/image-ratio-unit-tests.mjs",
        "test:cache": "node scripts/asset-cache-unit-tests.mjs",
        "test:refimage": "node scripts/image-reference-unit-tests.mjs",
        "test:sweep": "node scripts/stale-sweep-unit-tests.mjs",
        "test:result": "node scripts/generation-result-unit-tests.mjs",
        "test:recovery": "node scripts/generation-recovery-unit-tests.mjs",
        "test:retention": "node scripts/generation-media-retention-unit-tests.mjs",
        "test:refund": "node scripts/generation-refund-policy-unit-tests.mjs",
        "test:credentialhealth": "node scripts/credential-health-unit-tests.mjs",
        "test:resolution": "node scripts/image-resolution-unit-tests.mjs",
        "test:pricingkind": "node scripts/model-pricing-kind-unit-tests.mjs",
        "test:pruna": "node --import ./scripts/alias-hooks.mjs scripts/pruna-video-unit-tests.mjs",
        "test:webhook": "node scripts/replicate-webhook-unit-tests.mjs",
        "test:imgquality": "node --import ./scripts/alias-hooks.mjs scripts/image-quality-default-unit-tests.mjs",
        "test:refsupport": "node scripts/model-reference-support-unit-tests.mjs",
        "test:ark": "node scripts/ark-image-unit-tests.mjs",
        "test:marker": "node scripts/image-marker-unit-tests.mjs",
        "test:upstream": "node scripts/upstream-error-unit-tests.mjs",
        "test:artifact": "node scripts/generation-artifact-unit-tests.mjs",
        "test:inflight": "node scripts/upstream-inflight-unit-tests.mjs",
        "test:report": "node scripts/generation-report-unit-tests.mjs",
        "test:envelope": "node scripts/generation-envelope-unit-tests.mjs",
        "test:endpointpolicy": "node scripts/upstream-endpoint-policy-unit-tests.mjs",
        "test:budget": "node scripts/upstream-call-budget-unit-tests.mjs",
        "test:textpricing": "node --import ./scripts/alias-hooks.mjs scripts/text-pricing-unit-tests.mjs",
        "test:videopricing": "node --import ./scripts/alias-hooks.mjs scripts/video-second-pricing-unit-tests.mjs",
        "start": "next start",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate deploy",
        "db:seed": "prisma db seed"
    },
    "dependencies": {
        "@alicloud/dypnsapi20170525": "^2.0.0",
        "@alicloud/openapi-client": "^0.4.15",
        "@ant-design/icons": "^6.1.1",
        "@ant-design/nextjs-registry": "^1.3.0",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-json": "^6.0.2",
        "@fontsource/noto-serif-sc": "^5.2.8",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@tanstack/react-query": "^5.100.9",
        "@types/bcryptjs": "^3.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "jsonwebtoken": "^9.0.3",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "next": "16.3.1",
        "pg": "^8.22.0",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "resend": "^6.16.0",
        "shadcn": "^4.7.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "dotenv": "^17.4.2",
        "prettier": "^3.8.3",
        "prisma": "^7.8.0",
        "typescript": "^5"
    }
}
