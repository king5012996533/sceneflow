NEXT_PUBLIC_DOC_URL=/
# NEXT_PUBLIC_DIRECTOR_DESK_URL=/director-desk/

# 平台统一管理上游 API 密钥的加密密钥
# 必填：启用平台密钥库后，用于 AES-256-GCM 加解密 ProviderCredential.keyEnc
PLATFORM_KEY_ENCRYPTION_SECRET=
# 生产环境固定公网地址，用于 OAuth 回调和来源校验
PUBLIC_APP_URL=https://xingtudesign.com/canvas
# 内部生成任务轮询接口密钥（由 cron/worker 调用）
GENERATION_WORKER_SECRET=
# 服务端生成媒体归档目录；生产建议挂载持久卷或改为对象存储
GENERATION_MEDIA_DIR=
